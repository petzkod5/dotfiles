#!/usr/bin/env bash
#
# dotfiles-credentials — encrypted local storage for credentials used by dotfiles.
#
# Values are SOPS-encrypted with the per-user age identity. The cache lives in
# XDG state, never in the repository, and is only emitted to stdout for a caller
# that explicitly requests a supported credential.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: dotfiles-credentials get|set <sudo-password|bitwarden-master-password>
EOF
  exit 64
}

die() {
  printf 'dotfiles-credentials: %s\n' "$*" >&2
  exit 2
}

[ "$#" -eq 2 ] || usage
command="$1"
credential="$2"

case "$credential" in
  sudo-password|bitwarden-master-password) ;;
  *) usage ;;
esac

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
credential_dir="${state_home}/dotfiles/credentials"
credential_file="${credential_dir}/${credential}.env"
age_key_file="${SOPS_AGE_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt}"

require_sops() {
  command -v sops >/dev/null 2>&1 || die "sops is required to manage cached credentials."
  command -v age-keygen >/dev/null 2>&1 || die "age-keygen is required to manage cached credentials."
  [ -r "$age_key_file" ] || die "age identity unavailable at ${age_key_file}."
}

decode_base64() {
  if [ "$(uname -s)" = "Darwin" ]; then
    base64 -D
  else
    base64 -d
  fi
}

get_credential() {
  # A missing cache is an expected state; callers use status 1 to prompt.
  [ -f "$credential_file" ] || return 1
  require_sops

  local plaintext key encoded
  plaintext="$(SOPS_AGE_KEY_FILE="$age_key_file" sops --decrypt \
    --input-type dotenv --output-type dotenv "$credential_file")" \
    || die "cannot decrypt cached ${credential}."
  key="${plaintext%%=*}"
  encoded="${plaintext#*=}"
  [ "$key" = "DOTFILES_SECRET_B64" ] && [ -n "$encoded" ] \
    || die "cached ${credential} has an invalid format."
  printf '%s' "$encoded" | decode_base64
}

set_credential() {
  require_sops

  local secret recipient encoded temporary
  secret="$(cat)"
  [ -n "$secret" ] || die "refusing to store an empty ${credential}."
  recipient="$(age-keygen -y "$age_key_file")" \
    || die "cannot derive an age recipient from ${age_key_file}."
  encoded="$(printf '%s' "$secret" | base64 | tr -d '\n')"

  umask 077
  mkdir -p "$credential_dir"
  chmod 700 "$credential_dir"
  temporary="$(mktemp "${credential_dir}/.${credential}.XXXXXX")"
  trap 'rm -f "$temporary"' EXIT

  printf 'DOTFILES_SECRET_B64=%s\n' "$encoded" \
    | SOPS_AGE_KEY_FILE="$age_key_file" sops --encrypt \
        --age "$recipient" --input-type dotenv --output-type dotenv \
        --filename-override "$credential_file" /dev/stdin >"$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$credential_file"
  trap - EXIT
}

case "$command" in
  get) get_credential ;;
  set) set_credential ;;
  *) usage ;;
esac
